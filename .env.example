# Research Guard backend configuration. Copy to the ignored root .env for the local
# server and verification CLIs, or export values in the shell. Existing shell values
# take priority over this file.

# Public Supabase values. The same publishable key may be used by the SPA. Never use
# an sb_secret or legacy service_role key for ordinary saved-review requests.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_LOCALLY
RESEARCHGUARD_AUTH_TIMEOUT_SECONDS=10
RESEARCHGUARD_PERSISTENCE_TIMEOUT_SECONDS=10

# Exact React origins accepted by FastAPI. Add the one production HTTPS origin only
# when deploying; do not add Vercel preview wildcards.
RESEARCHGUARD_FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Optional exact custom backend host. Render's onrender.com host is added automatically
# from RENDER_EXTERNAL_HOSTNAME.
RESEARCHGUARD_ALLOWED_HOSTS=

# Optional NCBI contact address. This is not an authentication credential.
NCBI_EMAIL=researcher@example.com
# Optional Crossref polite-pool contact. NCBI_EMAIL is reused when this is unset.
CROSSREF_MAILTO=researcher@example.com

# The structured evidence workflow uses one explicitly selected server provider and
# never silently falls back. Groq GPT-OSS 20B is the recommended non-Gemini default
# because its strict JSON Schema mode is documented. Confirm that the account has no
# billing before enabling it. Keys never belong in frontend/VITE variables.
LLM_PROVIDER=groq
GROQ_API_KEY=REPLACE_IN_UNTRACKED_LOCAL_ENV
GROQ_FREE_TIER_CONFIRMED=false
GROQ_EXTRACTION_MODEL=openai/gpt-oss-20b
GROQ_ASSESSMENT_MODEL=openai/gpt-oss-20b

# Other explicitly selectable structured providers. OpenRouter is limited to its free
# router; NVIDIA is gated by operator confirmation. Gemini remains available only when
# explicitly selected, but is no longer the default.
OPENROUTER_API_KEY=
OPENROUTER_EXTRACTION_MODEL=openrouter/free
OPENROUTER_ASSESSMENT_MODEL=openrouter/free
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_FREE_TIER_CONFIRMED=false
NVIDIA_NIM_EXTRACTION_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_NIM_ASSESSMENT_MODEL=meta/llama-3.3-70b-instruct
GEMINI_API_KEY=REPLACE_IN_UNTRACKED_LOCAL_ENV
GEMINI_FREE_TIER_CONFIRMED=false
GEMINI_EXTRACTION_MODEL=gemini-3.8-flash
GEMINI_ASSESSMENT_MODEL=gemini-3.8-flash

# Optional signed-in general chat providers. These are server-only secrets. Leave a
# provider blank to show it as unavailable. Set a confirmation true only after checking
# that the account/project has no billing and uses its free tier.
# The same GROQ/OPENROUTER/NVIDIA keys above are reused by chat.

# Chat is bounded per verified account. Fallback is off by default and, when enabled,
# considers configured free-tier providers only. The response always reports the actual
# provider and model.
RESEARCHGUARD_CHAT_FALLBACK_ENABLED=false
RESEARCHGUARD_CHAT_REQUESTS_PER_MINUTE=6
RESEARCHGUARD_CHAT_TIMEOUT_SECONDS=45
RESEARCHGUARD_CHAT_PROVIDER_TIMEOUT_SECONDS=20
RESEARCHGUARD_CHAT_MAX_OUTPUT_TOKENS=1024
