# Research Guard backend configuration. Copy to the ignored root .env for the local
# server and verification CLIs, or export values in the shell. Existing shell values
# take priority over this file.

# Public Supabase values. The same publishable key may be used by the SPA. Never use
# an sb_secret or legacy service_role key for ordinary saved-review requests.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_LOCALLY
RESEARCHGUARD_AUTH_TIMEOUT_SECONDS=10
RESEARCHGUARD_PERSISTENCE_TIMEOUT_SECONDS=10

# Exact React origins accepted by FastAPI. Add the one production HTTPS origin only
# when deploying; do not add Vercel preview wildcards.
RESEARCHGUARD_FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Optional exact custom backend host. Render's onrender.com host is added automatically
# from RENDER_EXTERNAL_HOSTNAME.
RESEARCHGUARD_ALLOWED_HOSTS=

# Optional NCBI contact address. This is not an authentication credential.
NCBI_EMAIL=researcher@example.com

# Gemini remains server-side and Free Tier only. Add GEMINI_API_KEY to the real
# untracked .env/shell later; never put a secret value in this example file.
LLM_PROVIDER=gemini
GEMINI_API_KEY=REPLACE_IN_UNTRACKED_LOCAL_ENV
GEMINI_FREE_TIER_CONFIRMED=false
GEMINI_EXTRACTION_MODEL=gemini-3.8-flash
GEMINI_ASSESSMENT_MODEL=gemini-3.8-flash
