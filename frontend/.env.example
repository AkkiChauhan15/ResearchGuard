# Public browser configuration only. See ../docs/AUTH_SETUP.md.
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_LOCALLY
# Set these only for a hosted build. Keep them blank for the local Vite proxy.
VITE_API_BASE_URL=
VITE_APPLICATION_ORIGIN=
# Match the minimum shown in Supabase Authentication password settings.
VITE_SUPABASE_PASSWORD_MIN_LENGTH=6
